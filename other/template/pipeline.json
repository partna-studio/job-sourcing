{
    "name": "LinkedIn Job Search Auto Match",
    "steps": [
        {
            "name": "Schedule Trigger",
            "type": "n8n-nodes-base.scheduleTrigger",
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "triggerAtHour": 17
                        }
                    ]
                }
            },
            "utils": "../utils/scheduler.py",
            "next": "Download Resume from Drive"
        },
        {
            "name": "Download Resume from Drive",
            "type": "n8n-nodes-base.googleDrive",
            "parameters": {
                "operation": "download",
                "fileId": "YOUR_FILE_ID"
            },
            "credentials": "googleDriveOAuth2Api",
            "utils": "../utils/gdrive.py",
            "next": "Get Search Filters from Sheet"
        },
        {
            "name": "Get Search Filters from Sheet",
            "type": "n8n-nodes-base.googleSheets",
            "parameters": {
                "sheetName": "YOUR_SHEET_GID",
                "documentId": "YOUR_SHEET_ID"
            },
            "credentials": "googleSheetsOAuth2Api",
            "utils": "../utils/gdrive.py",
            "next": "Create LinkedIn Search URL"
        },
        {
            "name": "Create LinkedIn Search URL",
            "type": "n8n-nodes-base.code",
            "parameters": {
                "jsCode": "let url = \"https://www.linkedin.com/jobs/search/?f_TPR=r86400\"\n\nconst keyword = $input.first().json.Keyword\nconst location = $input.first().json.Location\nconst experienceLevel = $input.first().json['Experience Level']\nconst remote = $input.first().json.Remote\nconst jobType = $input.first().json['Job Type']\nconst easyApply = $input.first().json['Easy Apply']\n\nif (keyword != \"\") url += `&keywords=${keyword}`\nif (location != \"\") url += `&location=${location}`\n\nif (experienceLevel !== \"\") {\n  const transformedExperiences = experienceLevel.split(\",\").map((exp) => {\n    switch (exp.trim()) {\n      case \"Internship\": return \"1\"\n      case \"Entry level\": return \"2\"\n      case \"Associate\": return \"3\"\n      case \"Mid-Senior level\": return \"4\"\n      case \"Director\": return \"5\"\n      case \"Executive\": return \"6\"\n      default: return \"\"\n    }\n  }).filter(Boolean)\n  url += `&f_E=${transformedExperiences.join(\",\")}`\n}\n\nif (remote.length != \"\") {\n  const transformedRemote = remote.split(\",\").map((e) => {\n    switch (e.trim()) {\n      case \"Remote\": return \"2\"\n      case \"Hybrid\": return \"3\"\n      case \"On-Site\": return \"1\"\n      default: return \"\"\n    }\n  }).filter(Boolean)\n  url += `&f_WT=${transformedRemote.join(\",\")}`\n}\n\nif (jobType != \"\") {\n  const transformedJobType = jobType.split(\",\").map((type) => type.trim().charAt(0).toUpperCase())\n  url += `&f_JT=${transformedJobType.join(\",\")}`\n}\n\nif (easyApply != \"\") url += \"&f_EA=true\"\n\nreturn {url}"
            },
            "utils": "../utils/web.py",
            "next": "Fetch Jobs from LinkedIn"
        },
        {
            "name": "Fetch Jobs from LinkedIn",
            "type": "n8n-nodes-base.httpRequest",
            "parameters": {
                "url": "={{ $json.url }}"
            },
            "utils": "../utils/web.py",
            "next": "Extract Job Links"
        },
        {
            "name": "Extract Job Links",
            "type": "n8n-nodes-base.html",
            "parameters": {
                "operation": "extractHtmlContent",
                "extractionValues": {
                    "values": [
                        {
                            "key": "links",
                            "cssSelector": "ul.jobs-search__results-list li div a[class*=\"base-card\"]",
                            "returnValue": "attribute",
                            "attribute": "href",
                            "returnArray": true
                        }
                    ]
                }
            },
            "utils": "../utils/web.py",
            "next": "Split Job Links"
        },
        {
            "name": "Split Job Links",
            "type": "n8n-nodes-base.splitOut",
            "parameters": {
                "fieldToSplitOut": "links"
            },
            "utils": "N/A",
            "next": "Loop Over Jobs"
        },
        {
            "name": "Loop Over Jobs",
            "type": "n8n-nodes-base.splitInBatches",
            "utils": "N/A",
            "next": [
                null,
                "Wait Between Requests"
            ]
        },
        {
            "name": "Wait Between Requests",
            "type": "n8n-nodes-base.wait",
            "webhookId": "WEBHOOK_ID",
            "parameters": {
                "amount": 10
            },
            "utils": "N/A",
            "next": "Fetch Job Page"
        },
        {
            "name": "Fetch Job Page",
            "type": "n8n-nodes-base.httpRequest",
            "onError": "continueRegularOutput",
            "parameters": {
                "url": "={{ $json.links }}"
            },
            "retryOnFail": true,
            "waitBetweenTries": 5000,
            "utils": "../utils/web.py",
            "next": "Parse Job Details"
        },
        {
            "name": "Parse Job Details",
            "type": "n8n-nodes-base.html",
            "parameters": {
                "operation": "extractHtmlContent",
                "extractionValues": {
                    "values": [
                        {
                            "key": "title",
                            "cssSelector": "div h1"
                        },
                        {
                            "key": "company",
                            "cssSelector": "div span a"
                        },
                        {
                            "key": "location",
                            "cssSelector": "div span[class*='topcard__flavor topcard__flavor--bullet']"
                        },
                        {
                            "key": "description",
                            "cssSelector": "div.description__text.description__text--rich"
                        },
                        {
                            "key": "jobid",
                            "cssSelector": "a[data-item-type='semaphore']",
                            "returnValue": "attribute",
                            "attribute": "data-semaphore-content-urn"
                        }
                    ]
                }
            },
            "utils": "../utils/web.py",
            "next": "Format Job Data"
        },
        {
            "name": "Format Job Data",
            "type": "n8n-nodes-base.set",
            "parameters": {
                "assignments": {
                    "assignments": [
                        {
                            "name": "description",
                            "type": "string",
                            "value": "={{ $json.description.replaceAll(/\\s+/g, \" \") }}"
                        },
                        {
                            "name": "jobid",
                            "type": "string",
                            "value": "={{ $json.jobid.split(\":\").last() }}"
                        },
                        {
                            "name": "applyLink",
                            "type": "string",
                            "value": "={{ \"https://www.linkedin.com/jobs/view/\"+ $json.jobid.split(\":\").last() }} "
                        }
                    ]
                },
                "includeOtherFields": true
            },
            "utils": "N/A",
            "next": "AI Job Matcher"
        },
        {
            "name": "AI Job Matcher",
            "type": "@n8n/n8n-nodes-langchain.agent",
            "parameters": {
                "promptType": "define",
                "text": "=Hi, you are a helpful job matcher. Analyze the resume and job description to determine a match score. Do NOT write a cover letter. Your output MUST be a valid JSON object matching this structure exactly:\n\n{\n  \"airtable_dashboard\": {\n    \"summary_metrics\": [\n      { \"title\": \"Total Jobs Analyzed\", \"calculation_logic\": \"Count of all records pulled\", \"timestamp_ref\": \"03:10\" },\n      { \"title\": \"Average Final Job Score\", \"calculation_logic\": \"Mean of all Final Scores\", \"timestamp_ref\": \"03:15\" },\n      { \"title\": \"Top Scoring Jobs\", \"calculation_logic\": \"Count of jobs exceeding threshold\", \"timestamp_ref\": \"03:19\" }\n    ],\n    \"visualizations\": [\n      { \"graph_title\": \"Open Roles by Company\", \"graph_type\": \"Bar Chart\", \"axes\": { \"x_axis\": \"Company Name\", \"y_axis\": \"Count of Job IDs\" }, \"timestamp_ref\": \"03:22\" },\n      { \"graph_title\": \"Openings by Experience Level\", \"graph_type\": \"Bar or Pie Chart\", \"parameters\": [\"Junior\", \"Middle\", \"Senior\", \"Director\"], \"timestamp_ref\": \"03:27\" },\n      { \"graph_title\": \"Jobs Posted per Day\", \"graph_type\": \"Timeline\", \"axes\": { \"x_axis\": \"Publication Date\", \"y_axis\": \"Count of Records\" }, \"timestamp_ref\": \"03:39\" },\n      { \"graph_title\": \"Top Ranking Skills\", \"graph_type\": \"Word Cloud\", \"parameters\": [\"Python\", \"SQL\", \"AWS\", \"Generative AI\"], \"timestamp_ref\": \"03:47\" }\n    ],\n    \"data_table_schema\": {\n      \"metadata_fields\": [\"Job ID\", \"Publication Date\", \"LinkedIn Company Name\", \"Job Title\", \"Job Link\"],\n      \"categorization_fields\": [\"Experience Level\", \"Required Skills\", \"Responsibilities\", \"Company Benefits\"],\n      \"scoring_fields_0_100\": [\"Skills Score\", \"Responsibilities Score\", \"Experience Score\", \"Benefits Score\"],\n      \"final_output_fields\": [\"Final Job Score (weighted average)\", \"Remote/Flexible Work status\"],\n      \"data_source_pipeline\": \"LinkedIn > RSS.app > n8n > Airtable\",\n      \"timestamp_ref\": \"02:19\"\n    }\n  }\n}\n\njob_description: {{ $json.description }}\nmy_resume: {{ $('Extract Text from Resume').item.json.text }}"
            },
            "uses": "AI Model (OpenAI/Gemini)",
            "utils": "../utils/lchain.py",
            "next": "Parse AI Response"
        },
        {
            "name": "AI Model (OpenAI/Gemini)",
            "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
            "parameters": {
                "model": "gpt-4-mini"
            },
            "credentials": "openAiApi",
            "utils": "../utils/lchain.py"
        },
        {
            "name": "Parse AI Response",
            "type": "n8n-nodes-base.set",
            "parameters": {
                "mode": "raw",
                "jsonOutput": "={{ $json.output.replaceAll(/```(?:json)?/g, \"\") }}\n",
                "includeOtherFields": true
            },
            "utils": "../utils/parser.py",
            "next": "Save to Google Sheets"
        },
        {
            "name": "Save to Google Sheets",
            "type": "n8n-nodes-base.googleSheets",
            "parameters": {
                "operation": "appendOrUpdate",
                "documentId": "YOUR_SHEET_ID",
                "sheetName": "gid=0",
                "columns": {
                    "mappingMode": "defineBelow",
                    "matchingColumns": [
                        "link"
                    ],
                    "value": {
                        "Title": "={{ $('Format Job Data').item.json.title }}",
                        "Company": "={{ $('Format Job Data').item.json.company }}",
                        "Location": "={{ $('Format Job Data').item.json.location }}",
                        "link": "={{ $('Format Job Data').item.json.applyLink }}",
                        "score": "={{ $json.airtable_dashboard.data_table_schema.final_output_fields[0] }}",
                        "description": "={{ $('Format Job Data').item.json.description }}"
                    }
                }
            },
            "credentials": "googleSheetsOAuth2Api",
            "utils": "../utils/gdrive.py",
            "next": "Loop Over Jobs"
        }
    ]
}